<Project>

  <!-- Eredita dal Directory.Build.props della radice, non lo sostituisce. -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <!--
    xUnit v3 su Microsoft.Testing.Platform (ADR-0009, decisione 2).
    v3 e' necessaria, non preferita: IAssemblyFixture non esiste in v2, e
    senza di essa il container SQL Server andrebbe condiviso da una
    collection che abbraccia l'intera assembly, perdendo il parallelismo.
  -->
  <!--
    🔴 Condizionato su IsTestProject (Blocco 4). Sotto tests/ non vive solo codice di test:
    Roamly.TestSupport e' una LIBRERIA (builder e registro, R33 di ADR-0009), referenziata da
    due progetti di test. Se ereditasse OutputType=Exe e il runner, Microsoft.Testing.Platform
    la tratterebbe come progetto di test senza test e l'intera solution uscirebbe con exit
    code 8 (TESTING.md §13). Il discriminatore e' gia' definito nel Directory.Build.props
    della radice: IsTestProject e' true solo per i progetti il cui nome finisce in "Tests".
  -->
  <PropertyGroup Condition="'$(IsTestProject)' == 'true'">
    <OutputType>Exe</OutputType>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <!--
    Nei test il nome del metodo e' una frase, non un identificatore: e' la
    prima cosa che si legge quando la CI diventa rossa. CA1707 (niente
    underscore) e CA1515 (tipi internal) vanno contro questo scopo, e valgono
    solo qui: nel codice di produzione restano attivi.
  -->
  <PropertyGroup>
    <NoWarn>$(NoWarn);CA1707;CA1515</NoWarn>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsTestProject)' == 'true'">
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
  </ItemGroup>

  <ItemGroup Condition="'$(IsTestProject)' == 'true'">
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
