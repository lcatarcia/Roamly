# Copia in .env (gia' in .gitignore) e imposta una password locale a piacere.
# Usata solo da docker-compose.yml per il container SQL Server di sviluppo.
ROAMLY_DEV_SA_PASSWORD=CambiaMi!123

# Tag dell'immagine SQL Server: deve essere IDENTICO alla costante SqlServerImage.Tag in
# tests/Roamly.IntegrationTests/Infrastructure/SqlServerImage.cs (R36, ADR-0009). Non e' scritto
# qui come valore di comodo: R36 vieta un secondo punto di pin nel codice versionato, e .env.example
# non e' scansionato da quel verificatore proprio perche' non e' codice eseguibile.
ROAMLY_SQLSERVER_IMAGE=mcr.microsoft.com/mssql/server:2022-CU27-ubuntu-22.04
