{
  "name": "roamly-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "design:contrast": "node scripts/contrast-check.mjs",
    "design:coverage": "node --test scripts/tests/contrast-coverage.test.mjs && node scripts/contrast-coverage-check.mjs",
    "design:lint-colors": "node scripts/lint-no-literal-colors.mjs",
    "design:guard-r11": "node scripts/guard-r11.mjs",
    "design:r21": "node scripts/r21-i18n-check.mjs",
    "design:axe": "node scripts/axe-check.mjs",
    "test:camper-flow": "node scripts/camper-flow-check.mjs",
    "test:fuel-estimate-flow": "node scripts/fuel-estimate-flow-check.mjs",
    "test:fuel-estimate": "node --test scripts/tests/fuel-estimate.test.mjs",
    "test:trip-journal-flow": "node scripts/trip-journal-flow-check.mjs",
    "test:password-change-flow": "node scripts/password-change-flow-check.mjs",
    "design:guard-font-assets": "node --test scripts/tests/display-font-usage.test.mjs scripts/tests/vite-asset-fingerprint.test.mjs && node scripts/guard-font-assets.mjs",
    "test:privacy-account": "node scripts/privacy-account-check.mjs",
    "design:check": "npm run design:contrast && npm run design:coverage && npm run design:lint-colors && npm run design:guard-r11 && npm run design:r21 && npm run design:axe && npm run design:guard-font-assets"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@tanstack/react-query": "^5.104.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.48.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
